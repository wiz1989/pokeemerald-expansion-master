mapscripts  TARC3_WeatherInstitute_1F_MapScripts {
}

// ### object scripts ###

script TARC3_Lab_F1_Rotom {
    lock
	faceplayer
	playmoncry(SPECIES_ROTOM, CRY_MODE_NORMAL)
	setspeaker("Rotom")
	msgbox("Bzzz... Bzzz...\pWe are charging the reactor!")
	release
    end
}

script TARC3_Lab_F1_Pansage {
    lock
	faceplayer
	playmoncry(SPECIES_PANSAGE, CRY_MODE_NORMAL)
	setspeaker("Pansage")
	msgbox("I am the most skilled employee\nof this facility.\pDon't disturb me!")
	release
    end
}

script TARC3_Lab_F1_Magnemite {
    lock
	faceplayer
	playmoncry(SPECIES_MAGNEMITE, CRY_MODE_NORMAL)
	setspeaker("Magnemite")
	msgbox("I am watching the facility's\nsecurity system.\pDo not tamper with the equipment!")
	release
    end
}

script TARC3_Lab_F1_Metagross {
    lock
	faceplayer
	playmoncry(SPECIES_METAGROSS, CRY_MODE_NORMAL)
	setspeaker("Metagross")
	msgbox("I will give some advice!")
	release
    end
}


