script TARC3_Azure_Observer {
	cant_see_if_set(FLAG_BASE_SLOWKING_BEATEN)
    lock
	faceplayer
	// call(Common_EventScript_PlaySpeciesCry_Return)
	setspeaker("Drampa")
	// createfieldmugshot(MUGSHOT_TEST, EMOTE_ALT)
	if (flag(FLAG_BASE_SLOWKING_BEATEN))
	{
		msgbox("We're cool again!")
	}
	else
	{
		setrespawn(HEAL_LOCATION_TARC3_SLOWKING)
		msgbox("This SLOWKING is so toxic!\pIt behaves like a king that\nguards its treasure.\pI wonder what's up there.")
		playmoncry(SPECIES_SLOWKING, CRY_MODE_ENCOUNTER)
		delay(40)
		waitmoncry
		ai_vs_ai_wild_battle(SPECIES_DRAMPA, SPECIES_SLOWKING, 25)
		callnative(WasBattleWon)
		if (var(VAR_RESULT) == TRUE)
		{
			setflag(FLAG_BASE_SLOWKING_BEATEN)
			setrespawn(HEAL_LOCATION_TARC3_START)
			setspeaker("Drampa")
			msgbox("Thanks for having my back!\pI need to go now, find the\nbully's house and burn it\lto the ground.")
			fadescreen(FADE_TO_BLACK)
			special(HealPlayerParty)

			callnative(GetCurrentTransformationSpecies)
			switch (var(VAR_RESULT))
			{
				case SPECIES_CASTFORM:
					removeobject(LOCALID_BASE_DRAMPA)
					removeobject(LOCALID_BASE_SLOWKING)
				case SPECIES_CASTFORM_RAINY:
					removeobject(LOCALID_RAINY_DRAMPA)
					removeobject(LOCALID_RAINY_SLOWKING)
				case SPECIES_CASTFORM_SUNNY:
					removeobject(LOCALID_SUNNY_DRAMPA)
					removeobject(LOCALID_SUNNY_SLOWKING)
				case SPECIES_CASTFORM_SNOWY:
					removeobject(LOCALID_SNOWY_DRAMPA)
					removeobject(LOCALID_SNOWY_SLOWKING)
			}
			delay(60)
			fadescreen(FADE_FROM_BLACK)
		}
	}
	release
    end
}

script TARC3_Azure_Flygon {
	cant_see_if_set(FLAG_BASE_FLYGON_BEATEN)
    lock
	faceplayer
	// call(Common_EventScript_PlaySpeciesCry_Return)
	setspeaker("Flygon")
	// createfieldmugshot(MUGSHOT_TEST, EMOTE_ALT)
	if (flag(FLAG_BASE_FLYGON_BEATEN))
	{
		goto(TARC3_Flygon_Post)
	}
	else
	{
		setrespawn(HEAL_LOCATION_TARC3_FLYGON)
		msgbox("The worst in the world is\nsnow and ice.\pI will keep you from\ncontrolling it!")
		setwildbattle(SPECIES_FLYGON, 25)
		playmoncry(SPECIES_FLYGON, CRY_MODE_ENCOUNTER)
		delay(40)
		waitmoncry
		dowildbattle
		callnative(WasBattleWon)
		if (var(VAR_RESULT) == TRUE)
		{
			lock
			faceplayer
			setflag(FLAG_BASE_FLYGON_BEATEN)
			setrespawn(HEAL_LOCATION_TARC3_START)
			setspeaker("Flygon")
			msgbox("You are trying to restore the\nbalance of the weather again?\pWell that sounds like an\nhonorable path.\pI guess you can have this then.")
			// setvar(VAR_CASTFORM_PHASE, 2)
			// setvar(VAR_TRIGGER_XATU_EVENT, 1)
			giveitem(ITEM_ICY_ROCK, 1)
			// givemon(SPECIES_CASTFORM_RAINY, 25)
			setflag(FLAG_ITEM_GLACIAL_SHARD)
			// setflag(FLAG_RUN_XATU_AZURE)
			msgbox("...\p...\pThis is the end of this beta.\pThe final release will feature another\nsegment with snowy weather,\lnew puzzles and a final boss fight.")
			checkitem(ITEM_MIRACLE_SEED, 8)
			if (var(VAR_RESULT) == TRUE) {
				msgbox("You have found all eight\nMIRACLE SEEDS already!\pGreat job!\nThis is all for now.")
			}
			else {
				msgbox("There is eight MIRACLE SEEDS\nto be found.\lKeep looking!")
			}
			releaseall
			// warp(MAP_TARC3_WEATHER_INSTITUTE_2F, 9, 8)
			// waitstate
		}
	}
	release
    end
}

// end battle scripts

script TARC3_Paras_Post {
	playmoncry(SPECIES_SURSKIT, CRY_MODE_NORMAL)

	callnative(GetCurrentTransformationSpecies)
	switch (var(VAR_RESULT))
	{
		case SPECIES_CASTFORM_SUNNY:
			msgbox("I am enjoying the warmth!\pJust keep any Fire Types away!")
		case SPECIES_CASTFORM_RAINY:
		case SPECIES_CASTFORM_SNOWY:
			msgbox("What's this weather?\pThis is miserable, I can't stand it!")
		case SPECIES_CASTFORM:
		default:
			msgbox("You can make it sunny?\pI am rooting for you!")
	}
	release
    end
}

script TARC3_Surskit {
    lock
	faceplayer
	playmoncry(SPECIES_SURSKIT, CRY_MODE_NORMAL)
	setspeaker("Surskit")
	callnative(GetCurrentTransformationSpecies)
	switch (var(VAR_RESULT))
	{
		case SPECIES_CASTFORM_SUNNY:
			msgbox("My pond!\nWhere did it go???")
		case SPECIES_CASTFORM_RAINY:
			msgbox("You made this rain?\pI LOVE IT!\nPlease never make it stop.")
		case SPECIES_CASTFORM_SNOWY:
		case SPECIES_CASTFORM:
		default:
			msgbox("The weather has been crazy lately!\pI hope it calms down soon.")
	}
	release
    end
}

