mapscripts  TARC3_base_MapScripts {
	MAP_SCRIPT_ON_RESUME: TARC3_Base_OnResume
}

script TARC3_Base_OnResume {
	setstepcallback(STEP_CB_CLAY_TILES)
	end
}

// migration scripts

script TARC3_Base_Sunkern {
	goto(TARC3_Base_Paras)
}

// object scripts

script TARC3_Base_Paras {
	cant_see_if_set(FLAG_BASE_PARAS_BEATEN)
    lock
	faceplayer
	createfieldmugshot(MUGSHOT_TEST, EMOTE_NORMAL) // wiz1989: change mugshot!
	setspeaker("Paras")
	if (flag(FLAG_BASE_PARAS_BEATEN))
	{
		msgbox("I still like you!")
	}
	else
	{
		msgbox("Hi, I'm PARAS.\nLet's battle!")
		setwildbattle(SPECIES_PARAS, 25)
		playmoncry(SPECIES_PARAS, CRY_MODE_ENCOUNTER)
		delay(40)
		waitmoncry
		dowildbattle
		callnative(WasBattleWon)
		if (var(VAR_RESULT) == TRUE)
		{
			setflag(FLAG_BASE_PARAS_BEATEN)
		}
	}
	release
    end
}

