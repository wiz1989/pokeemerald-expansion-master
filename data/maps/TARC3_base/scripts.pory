script TARC3_Amber_Munchlax {
	cant_see_if_set(FLAG_BASE_MUNCHLAX_BEATEN)
    lock
	faceplayer
	// call(Common_EventScript_PlaySpeciesCry_Return)
	// createfieldmugshot(MUGSHOT_TEST, EMOTE_NORMAL) // wiz1989: change mugshot!
	setspeaker("Munchlax")
	if (flag(FLAG_BASE_MUNCHLAX_BEATEN))
	{
		goto(TARC3_Munchlax_Post)
	}
	else
	{
		if (var(VAR_TRANSFORM_MON) == SPECIES_CASTFORM_SUNNY)
		{
			msgbox("It's too hot to battle!")
			applymovement(LOCALID_PLAYER, moves(
				walk_up * 2
				face_down
			))
			waitmovement(0)
			release
			end
		}
		else
		{
			setrespawn(HEAL_LOCATION_TARC3_MUNCHLAX)
			setspeaker("Munchlax")
			msgbox("Do you have some berries for me?\nI am hungry!")
			setwildbattle(SPECIES_MUNCHLAX, 25)
			playmoncry(SPECIES_MUNCHLAX, CRY_MODE_ENCOUNTER)
			delay(40)
			waitmoncry
			dowildbattle
			callnative(WasBattleWon)
			if (var(VAR_RESULT) == TRUE)
			{
				setflag(FLAG_BASE_MUNCHLAX_BEATEN)
				setrespawn(HEAL_LOCATION_TARC3_START)
			}
		}
	}
	release
    end
}

