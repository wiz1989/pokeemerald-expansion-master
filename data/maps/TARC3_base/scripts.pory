mapscripts  TARC3_base_MapScripts {
	MAP_SCRIPT_ON_RESUME: TARC3_Base_OnResume
}

script TARC3_Base_OnResume {
	setstepcallback(STEP_CB_CLAY_TILES)
	
	callnative(GetCurrentTransformationSpecies) // = get current weather/map
	switch (var(VAR_RESULT))
	{
		case SPECIES_CASTFORM_RAINY:
			setflag(FLAG_HIDE_ITEM_UNDERWATER)
		case SPECIES_CASTFORM_SNOWY:
			setflag(FLAG_HIDE_ITEM_UNDERWATER)
		case SPECIES_CASTFORM_SUNNY:
			if (!flag(FLAG_ITEM_COLLECTIBLE_2)) {
				clearflag(FLAG_HIDE_ITEM_UNDERWATER)
			}
		case SPECIES_CASTFORM:
		default:
			setflag(FLAG_HIDE_ITEM_UNDERWATER)
	}
	end
}

// migration scripts (can be deleted before release)

script TARC3_Base_Sunkern {
	goto(TARC3_Base_Paras)
}

script TARC3_Base_Wooper {
	goto(TARC3_Base_Dewpider)
}

script TARC3_Base_Torkoal {
	goto(TARC3_Amber_Torkoal)
}

// ### object scripts ###

// Base phase
script TARC3_Base_Paras {
	cant_see_if_set(FLAG_BASE_PARAS_BEATEN)
    lock
	faceplayer
	// call(Common_EventScript_PlaySpeciesCry_Return)
	// createfieldmugshot(MUGSHOT_TEST, EMOTE_NORMAL) // wiz1989: change mugshot!
	setspeaker("Paras")
	if (flag(FLAG_BASE_PARAS_BEATEN))
	{
		goto(TARC3_Paras_Post)
	}
	else
	{
		setrespawn(HEAL_LOCATION_TARC3_START)
		setspeaker("Paras")
		msgbox("Weather Shards?\nI only heard of fungal spores.\pDoes that help?")
		setwildbattle(SPECIES_PARAS, 25)
		playmoncry(SPECIES_PARAS, CRY_MODE_ENCOUNTER)
		delay(40)
		waitmoncry
		dowildbattle
		callnative(WasBattleWon)
		if (var(VAR_RESULT) == TRUE)
		{
			setflag(FLAG_BASE_PARAS_BEATEN)
			setrespawn(HEAL_LOCATION_TARC3_START)
		}
	}
	release
    end
}

