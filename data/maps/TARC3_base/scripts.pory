script TARC3_Whimsicott {
    lock
	faceplayer
	setspeaker("Whimsicott")
	// createfieldmugshot(MUGSHOT_WHIMSICOTT, EMOTE_NORMAL)
	if (flag(FLAG_WHIMSICOTT_GAVE_SEED))
	{
		msgbox("When you plant and water it,\nit will grow!\pBut don't expect much from these\nApricorn trees.\lThey haven't changed in ages.")
	}
	else
	{
		msgbox("Hi there, glad you found me!\pMy name is Whimsicott and\nI am the gardener of this town.\pHere, you can have a seed, too.")
		playmoncry(SPECIES_WHIMSICOTT, CRY_MODE_NORMAL)
		delay(40)
		waitmoncry
		giveitem(ITEM_WEPEAR_BERRY, 1)
		setflag(FLAG_WHIMSICOTT_GAVE_SEED)
		msgbox("When you plant and water it,\nit will grow!\pBut don't expect much from these\nApricorn trees.\lThey haven't changed in ages.")
	}
	release
    end
}

script TARC3_Feebas {
    lock
	faceplayer
	setspeaker("Feebas")
