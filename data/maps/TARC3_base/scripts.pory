script TARC3_Goodra {
	lock
	faceplayer
	setspeaker("Goodra")
	// createfieldmugshot(MUGSHOT_GOODRA, EMOTE_NORMAL)
	playmoncry(SPECIES_GOODRA, CRY_MODE_NORMAL)
	if (flag(FLAG_GOODRA_GAVE_ITEM)) {
		msgbox("I tried evolving for so long,\nbut I had no idea how...")
	}
	else {
		msgbox("You made it rain.\nThat was it!\pThank you so much for the help!\pHere, takes this.")
		giveitem(ITEM_MIRACLE_SEED)
		setflag(FLAG_GOODRA_GAVE_ITEM)
		msgbox("I tried evolving for so long,\nbut I had no idea how...")
	}
	release
	end
}

script TARC3_Lapras1_Source {
	lock
	faceplayer
	setspeaker("Lapras")
	// createfieldmugshot(MUGSHOT_LAPRAS, EMOTE_NORMAL)
	playmoncry(SPECIES_LAPRAS, CRY_MODE_NORMAL)
	msgbox("Hello my friend!\nYou are trying to save us all?\pIf you find me and my friend\nwe might be able to assist\lyou on the mission.")
	applymovement(VAR_LAST_TALKED, moves(
			walk_down * 3
			walk_right * 2
			walk_down * 3
	))
	waitmovement(0)
	removeobject(VAR_LAST_TALKED)
	setflag(FLAG_LAPRAS1_SOURCE_INVISIBLE)
	clearflag(FLAG_LAPRAS1_DEST_INVISIBLE)
	release
    end
}

script TARC3_Lapras2_Source {
	lock
	faceplayer
	setspeaker("Lapras")
	// createfieldmugshot(MUGSHOT_LAPRAS, EMOTE_NORMAL)
	playmoncry(SPECIES_LAPRAS, CRY_MODE_NORMAL)
	msgbox("Yay, a new friend!\pLet's meet at the little island\nWEST from here.")
	applymovement(VAR_LAST_TALKED, moves(
			walk_right * 5
			walk_up
			walk_right
			walk_up
			walk_right
			walk_up
			walk_right
			walk_up
			walk_right
	))
	waitmovement(0)
	removeobject(VAR_LAST_TALKED)
	setflag(FLAG_LAPRAS2_SOURCE_INVISIBLE)
	clearflag(FLAG_LAPRAS2_DEST_INVISIBLE)
	release
    end
}

