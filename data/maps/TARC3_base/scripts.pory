script TARC3_Audino {
    lock
	faceplayer
	setspeaker("Audino")
	// createfieldmugshot(MUGSHOT_AUDINO, EMOTE_NORMAL)
	playmoncry(SPECIES_AUDINO, CRY_MODE_NORMAL)
	if (flag(FLAG_AUDINO_GAVE_HERBICIDE)) {
		goto(TARC3_Audino_Post)
	}
	else {
		msgbox("Whimsicott taught me how to\nreverse-grow plants.\pBut I am no gardener myself.\nYou can have this.")
		giveitem(ITEM_HYPER_POTION)
		setflag(FLAG_AUDINO_GAVE_HERBICIDE)
		goto(TARC3_Audino_Post)
	}
}

