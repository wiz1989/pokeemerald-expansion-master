// end battle scripts

script TARC3_Paras_Post {
	playmoncry(SPECIES_SURSKIT, CRY_MODE_NORMAL)

	callnative(GetCurrentTransformationSpecies)
	switch (var(VAR_RESULT))
	{
		case SPECIES_CASTFORM_SUNNY:
			msgbox("I am enjoying the warmth!\pJust keep any Fire Types away!")
		case SPECIES_CASTFORM_RAINY:
		case SPECIES_CASTFORM_SNOWY:
			msgbox("What's this weather?\pThis is miserable, I can't stand it!")
		case SPECIES_CASTFORM:
		default:
			msgbox("You can make it sunny?\pI am rooting for you!")
	}
	release
    end
}

script TARC3_Surskit {
    lock
	faceplayer
	playmoncry(SPECIES_SURSKIT, CRY_MODE_NORMAL)
	setspeaker("Surskit")
	callnative(GetCurrentTransformationSpecies)
	switch (var(VAR_RESULT))
	{
		case SPECIES_CASTFORM_SUNNY:
			msgbox("My pond!\nWhere did it go???")
		case SPECIES_CASTFORM_RAINY:
			msgbox("You made this rain?\pI LOVE IT!\nPlease never make it stop.")
		case SPECIES_CASTFORM_SNOWY:
		case SPECIES_CASTFORM:
		default:
			msgbox("The weather has been crazy lately!\pI hope it calms down soon.")
	}
	release
    end
}

script TARC3_Vulpix_Post {
	playmoncry(SPECIES_VULPIX, CRY_MODE_NORMAL)

	callnative(GetCurrentTransformationSpecies)
	switch (var(VAR_RESULT))
	{
		default:
			msgbox("You transformed and even\nchanged your moveset?\pThat is so cool!\nHow did you do that?")
	}
	release
    end
}

script TARC3_Dewpider_Post {
	playmoncry(SPECIES_DEWPIDER, CRY_MODE_NORMAL)

	callnative(GetCurrentTransformationSpecies)
	switch (var(VAR_RESULT))
	{
		case SPECIES_CASTFORM_SUNNY:
			msgbox("What did you do???\pWhere did my home go???")
		default:
			msgbox("Please be careful!")
	}
	release
    end
}

script TARC3_Whimsicott {
    lock
	faceplayer
	setspeaker("Whimsicott")
	// createfieldmugshot(MUGSHOT_WHIMSICOTT, EMOTE_NORMAL)
	if (flag(FLAG_WHIMSICOTT_GAVE_SEED))
	{
		msgbox("You'll be a great gardener!")
	}
	else
	{
		msgbox("Hi, I'm WHIMSICOTT.\nTake this seed!")
		playmoncry(SPECIES_WHIMSICOTT, CRY_MODE_NORMAL)
		delay(40)
		waitmoncry
		giveitem(ITEM_WEPEAR_BERRY, 1)
		setflag(FLAG_WHIMSICOTT_GAVE_SEED)
		msgbox("You'll be a great gardener!")
	}
	release
    end
}

script TARC3_Sign_TreeOfLife {
	msgbox("Tree of Life\pOnly Arceus may enter.", MSGBOX_SIGN)
	end
}

script TARC3_Sign_ApricornTree {
	msgbox("An Apricorn Tree blocks\nthe entrance.\pPost game area.", MSGBOX_SIGN)
	end
}

script TARC3_Find_IceClimb {
	finditem(ITEM_TM01, 1)
	end
}

script TARC3_Dummy_Start_Amber {
	lockall
	setvar(VAR_CASTFORM_PHASE, 1)
	finditem(ITEM_HEAT_ROCK, 1)
	givemon(SPECIES_CASTFORM_SUNNY, 25)
	msgbox("Base phase completed!\pAmber shard unlocked!\pPress SELECT to change weather.")
	waitmessage
	warp(MAP_TARC3_BASE, 0)
	setflag(FLAG_ITEM_AMBER_SHARD)
	waitstate
	releaseall
	end
}
